APP_NAME=BookMatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── DATABASE ─────────────────────────────────────────────────────────
# Pilihan 1: MySQL (lebih baik untuk skripsi, bisa visualisasi di phpMyAdmin)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookmatch
DB_USERNAME=root
DB_PASSWORD=

# Pilihan 2: SQLite (lebih simpel, tidak perlu install MySQL)
# Uncomment baris di bawah dan comment blok MySQL di atas
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
